# Card-effect AI extraction deployment boundary.
# The runtime Base URL, Model ID, enabled state, and encrypted API Key are managed in PostgreSQL.
# Generate a unique 32-byte master key and encode it as 64 hex characters or base64.
AI_EFFECT_EXTRACTION_ENCRYPTION_KEY=
AI_EFFECT_EXTRACTION_ALLOWED_HOSTS=dashscope.aliyuncs.com

# API Server
PORT=3007
NODE_ENV=development

# Historical replay process-local cache and opt-in structured performance probe.
MATCH_REPLAY_NODE_CACHE_MAX_ENTRIES=128
MATCH_REPLAY_NODE_CACHE_MAX_BYTES=67108864
MATCH_REPLAY_PERFORMANCE_PROBE=false

# PostgreSQL
DATABASE_URL=postgres://loveca:loveca_dev@localhost:5432/loveca
POSTGRES_PASSWORD=loveca_dev

# Tencent CloudBase (optional; used by the admin new-card sync and CloudBase scripts)
# Keep real credentials only in the deployment/local environment file. Never commit them.
CLOUDBASE_ENV_ID=your_cloudbase_env_id
CLOUDBASE_SECRET_ID=your_tencent_secret_id
CLOUDBASE_SECRET_KEY=your_tencent_secret_key

# JWT (use random strings of 32+ characters)
JWT_SECRET=your_jwt_secret_at_least_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_at_least_32_chars

# MinIO
# localhost:9000 is the local test default. If you use it, make sure MinIO is
# configured and card image/static resources have been preprocessed/uploaded.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=loveca-cards
# Private bucket for player-uploaded wallpapers. Never grant anonymous read access.
MINIO_WALLPAPER_BUCKET=loveca-user-assets
MINIO_USE_SSL=false

# Player wallpaper processing. Keep this at or below the API host's safe Sharp concurrency.
PLAYER_WALLPAPER_PROCESSING_CONCURRENCY=2
PLAYER_WALLPAPER_PROCESSING_TIMEOUT_SECONDS=15
PLAYER_WALLPAPER_RETIRED_RETENTION_HOURS=24

# SMTP (optional, for email verification and password reset)
# EMAIL_ENABLED=true makes email mandatory at registration and blocks login until verification.
# Enable it only when SMTP_* is configured; the server refuses to start on an incomplete setup.
EMAIL_ENABLED=false
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASS=your_email_password
# SMTP_FROM=noreply@loveca.app

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:5173

# Independent public maintenance snapshot (must be outside client/dist in production)
PUBLIC_SITE_STATUS_SNAPSHOT_PATH=./runtime/site-status/site-status.json
